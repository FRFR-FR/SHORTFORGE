{
  "name": "shortforge-animeforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Claude Code Agent SDK + Three.js 2.5D horizontal anime episode production engine",
  "scripts": {
    "agent": "node src/agent.mjs",
    "validate": "node src/validate.mjs",
    "render": "node src/render.mjs",
    "demo": "node src/render.mjs --project projects/demo/episode.json --output out/animeforge-demo.mp4",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.329",
    "pngjs": "^7.0.0",
    "playwright": "^1.65.1",
    "three": "^0.187.0"
  },
  "engines": {
    "node": ">=22"
  }
}